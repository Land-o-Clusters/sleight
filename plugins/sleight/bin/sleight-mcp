#!/bin/sh
# Runs lib/launch.mjs with the Node that ships inside the ChatGPT app, so
# sleight needs nothing installed beyond ChatGPT itself.
APP_NODE="${SLEIGHT_CHATGPT_APP:-/Applications/ChatGPT.app}/Contents/Resources/cua_node/bin/node"
if [ -x "$APP_NODE" ]; then
  NODE="$APP_NODE"
elif command -v node >/dev/null 2>&1; then
  NODE="$(command -v node)"
else
  echo "sleight: ChatGPT.app not found at ${SLEIGHT_CHATGPT_APP:-/Applications/ChatGPT.app}, and no node on PATH" >&2
  exit 1
fi
if [ "$#" -eq 1 ] && [ "$1" = session ]; then
  # Clear loader variables before Node starts. The session fills HOME/USER from the OS
  # and changes to its validated cache directory before starting any helpers.
  exec /usr/bin/env -i PATH=/usr/bin:/bin LANG=en_US.UTF-8 TMPDIR=/private/tmp \
    SLEIGHT_CHATGPT_APP="${SLEIGHT_CHATGPT_APP:-/Applications/ChatGPT.app}" \
    "$NODE" "$(dirname "$0")/../lib/launch.mjs" "$@"
fi
exec "$NODE" "$(dirname "$0")/../lib/launch.mjs" "$@"
