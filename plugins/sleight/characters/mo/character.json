  "lines": {
    "lang": "en",
    "start": [
      "I am here. Give the arm a moment.",
      "Arrived. Eventually is a place.",
      "Found a comfortable edge.",
      "Ready enough.",
      "One slow breath. Then we begin."
    ],
    "first-click": [
      "There. A point.",
      "The arm was already on its way.",
      "First click, in good time.",
      "I saw it. Slowly.",
      "A gentle start."
    ],
    "typing": [
      "The agent types. I supervise.",
      "Plenty of time for a blink.",
      "Words move faster than I do.",
      "Keeping the paper steady.",
      "A very small nod."
    ],
    "long-wait": [
      "My specialty.",
      "No need to fill the silence.",
      "This is a good hanging spot.",
      "Still here. Same blink.",
      "We can share the quiet."
    ],
    "approval": [
      "Your decision. I have time.",
      "Holding the card steady.",
      "You can read it at your own pace.",
      "I will wait for your answer.",
      "A yes or no when you are ready."
    ],
    "error": [
      "A slow wince.",
      "That needs a moment.",
      "Let the arm come back down.",
      "I saw the snag.",
      "Hanging here while we sort it out."
    ],
    "done": [
      "A smile. Nearly there. There.",
      "Finished before my blink.",
      "That went quickly for one of us.",
      "One very slow nod.",
      "The work is done. I can rest."
    ],
    "handback": [
      "Back to you, at your pace.",
      "The pointer is yours.",
      "Take the next move.",
      "I will keep this edge warm.",
      "Handing back. Slowly."
    ],
    "wake": [
      "Was I asleep?",
      "Same pose. New task.",
      "The eyes are opening.",
      "I did notice.",
      "Let me finish this blink."
    ]
  }
