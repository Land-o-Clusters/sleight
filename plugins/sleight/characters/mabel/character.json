  "lines": {
    "lang": "en",
    "start": [
      "This edge will do.",
      "I was sitting here already.",
      "Yes, I see the ring.",
      "A new window. More furniture.",
      "One paw on the job."
    ],
    "first-click": [
      "That dot again.",
      "I meant to do that.",
      "Paw placed.",
      "You saw nothing.",
      "A respectable first bat."
    ],
    "typing": [
      "The keys are warm.",
      "These paws were built for this.",
      "Tap. Tap. Enough.",
      "I prefer the quiet keys.",
      "Still spelling it out."
    ],
    "long-wait": [
      "I can wait in this position.",
      "An excellent edge for a loaf.",
      "Still here. Obviously.",
      "The tail has its own schedule.",
      "Wake me when it moves."
    ],
    "approval": [
      "Your call. I have no thumbs.",
      "I will hold the card.",
      "You decide. I will sit.",
      "Waiting for your answer.",
      "One yes or no, please."
    ],
    "error": [
      "Ears back. Taking a breath.",
      "That did not land.",
      "A small indignity.",
      "I saw that too.",
      "Pausing to inspect the damage."
    ],
    "done": [
      "Pencil off the edge. My contribution.",
      "A slow blink for that one.",
      "Done. The edge is mine again.",
      "You may admire the paw work.",
      "That is the last bat."
    ],
    "handback": [
      "Your pointer. Try not to lose it.",
      "Back to you.",
      "I am leaving the ring here.",
      "You have the next move.",
      "My shift ends on this edge."
    ],
    "wake": [
      "I was resting my eyes.",
      "Yes, yes. Awake.",
      "The window is still here.",
      "Tail first, then the rest.",
      "A stretch before we continue."
    ]
  }
