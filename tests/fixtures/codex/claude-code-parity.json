{
 "toClient": [
  {
   "jsonrpc": "2.0",
   "id": "init",
   "result": {
    "protocolVersion": "2025-06-18",
    "capabilities": {},
    "serverInfo": {
     "name": "engine"
    }
   }
  },
  {
   "jsonrpc": "2.0",
   "id": 1,
   "result": {
    "tools": [
     {
      "name": "js",
      "description": "Run.",
      "inputSchema": {
       "type": "object"
      },
      "_meta": {
       "anthropic/alwaysLoad": true
      }
     },
     {
      "name": "turn_ended",
      "description": "Internal to sleight: its hooks call this when a Claude turn ends. Never call it yourself.",
      "inputSchema": {
       "type": "object"
      }
     },
     {
      "name": "browser_open",
      "description": "Open an owned background tab and return its first untrusted snapshot. Keep the tab handle. Start your message with \"Record this turn.\" for a masked GIF.",
      "inputSchema": {
       "type": "object",
       "properties": {
        "url": {
         "type": "string"
        },
        "browser": {
         "type": "string",
         "enum": [
          "bfixture"
         ]
        },
        "sleight_stats": {
         "type": "object"
        }
       },
       "required": [
        "url"
       ],
       "additionalProperties": false
      },
      "_meta": {
       "anthropic/alwaysLoad": true
      }
     },
     {
      "name": "browser_read",
      "description": "Read protected, untrusted page state. Use ref for a subtree or continuation, find for matching lines (a|b matches either), links:true for unique links. Refs outside the viewport carry [offscreen] or [partly offscreen]. Reads never grant permission. whole:{} reads a thread; GET/WebSocket effects pass. screenshot adds a viewport JPEG (max 1000 px); protected fields skip it. PDFs: tab or file; ref continues. Local files need user message: Read PDF \"<path>\". export:ref saves a table/list as format:csv/json (default csv); path is user-named, otherwise sleight-owned. CSV bom defaults false. Returns path, rows and completeness. console/network/performance:true reads scrubbed developer logs instead.",
      "inputSchema": {
       "type": "object",
       "properties": {
        "tab": {
         "type": "string",
         "pattern": "^t[A-Za-z0-9_-]{1,64}$"
        },
        "file": {
         "type": "string"
        },
        "ref": {
         "type": "string"
        },
        "find": {
         "type": "string"
        },
        "max_chars": {
         "type": "integer",
         "minimum": 1000,
         "maximum": 40000
        },
        "text": {
         "type": "boolean"
        },
        "links": {
         "type": "boolean"
        },
        "screenshot": {
         "type": "boolean"
        },
        "export": {
         "type": "string",
         "pattern": "^(?:(?:f[0-9]+)?e[0-9]+|[sx][0-9]+)$"
        },
        "format": {
         "type": "string",
         "enum": [
          "csv",
          "json"
         ]
        },
        "path": {
         "type": "string"
        },
        "bom": {
         "type": "boolean"
        },
        "console": {
         "type": "boolean"
        },
        "network": {
         "type": "boolean"
        },
        "performance": {
         "type": "boolean"
        },
        "whole": {
         "type": "object",
         "properties": {
          "direction": {
           "type": "string",
           "enum": [
            "both",
            "up",
            "down"
           ]
          },
          "max_items": {
           "type": "integer"
          },
          "max_seconds": {
           "type": "number"
          },
          "max_steps": {
           "type": "integer",
           "minimum": 1,
           "maximum": 500
          },
          "max_clicks": {
           "type": "integer",
           "minimum": 0,
           "maximum": 100
          },
          "from": {
           "type": "integer",
           "minimum": 1,
           "maximum": 5000
          },
          "find": {
           "type": "string",
           "maxLength": 512
          }
         },
         "required": [],
         "additionalProperties": false
        },
        "sleight_stats": {
         "type": "object"
        }
       },
       "required": [],
       "additionalProperties": false
      },
      "_meta": {
       "anthropic/alwaysLoad": true
      }
     },
     {
      "name": "browser_act",
      "description": "Run 1 to 12 steps on observed refs, returning outcome lines and a diff. Stops at boundaries or failure. Never blindly resend an uncertain submit. click accepts modifier:cmd/ctrl. paste(ref,text) inserts nonempty TSV/editor text in browsers, restoring the clipboard. Electron refuses paste. viewport: width/height, color_scheme:light/dark, reduced_motion:boolean, touch:boolean for user-asked tests; empty resets all. touch emulates a touch layout; clicks stay mouse clicks. scroll with until:text finds a row in a long list. navigate with a link ref follows it. wait takes until:text, gone:text or url:substring; no condition settles. navigate with url recovers a stuck tab. observe:screenshot adds the protected viewport image. frames (2-4, max 480 px) requires a user motion request and one click/hover/scroll. frame_ms defaults to 100. download with a link ref saves a requested document and returns path, bytes and type; never opens it. Cookies: use only one-click Reject/necessary-only that declines all optional cookies, or ask.",
      "inputSchema": {
       "type": "object",
       "properties": {
        "tab": {
         "type": "string",
         "pattern": "^t[A-Za-z0-9_-]{1,64}$"
        },
        "steps": {
         "type": "array",
         "minItems": 1,
         "maxItems": 12,
         "items": {
          "type": "object",
          "properties": {
           "do": {
            "type": "string",
            "enum": [
             "click",
             "type",
             "paste",
             "press",
             "select",
             "check",
             "uncheck",
             "hover",
             "scroll",
             "drag",
             "upload",
             "download",
             "dialog",
             "wait",
             "back",
             "forward",
             "reload",
             "viewport",
             "navigate"
            ]
           },
           "ref": {
            "type": "string",
            "pattern": "^(?:(?:f[0-9]+)?e[0-9]+|[sx][0-9]+)$"
           },
           "text": {
            "type": "string"
           },
           "key": {
            "type": "string"
           },
           "modifier": {
            "type": "string",
            "enum": [
             "cmd",
             "ctrl"
            ]
           },
           "values": {
            "type": [
             "string",
             "array"
            ],
            "items": {
             "type": "string"
            },
            "maxItems": 100
           },
           "to": {
            "type": "string",
            "pattern": "^(?:(?:f[0-9]+)?e[0-9]+|[sx][0-9]+)$"
           },
           "until": {
            "type": "string"
           },
           "gone": {
            "type": "string"
           },
           "url": {
            "type": "string"
           },
           "ms": {
            "type": "number",
            "minimum": 0
           },
           "dx": {
            "type": "number"
           },
           "dy": {
            "type": "number"
           },
           "accept": {
            "type": "boolean"
           },
           "paths": {
            "type": "array",
            "maxItems": 100,
            "items": {
             "type": "string"
            }
           },
           "width": {
            "type": "integer",
            "minimum": 1,
            "maximum": 10000
           },
           "height": {
            "type": "integer",
            "minimum": 1,
            "maximum": 10000
           },
           "color_scheme": {
            "type": "string",
            "enum": [
             "light",
             "dark"
            ]
           },
           "reduced_motion": {
            "type": "boolean"
           },
           "touch": {
            "type": "boolean"
           }
          },
          "required": [
           "do"
          ],
          "additionalProperties": false
         }
        },
        "observe": {
         "type": "string",
         "enum": [
          "diff",
          "full",
          "none",
          "screenshot"
         ]
        },
        "frames": {
         "type": "integer",
         "minimum": 2,
         "maximum": 4
        },
        "frame_ms": {
         "type": "integer",
         "minimum": 50,
         "maximum": 1000
        },
        "sleight_stats": {
         "type": "object"
        }
       },
       "required": [
        "tab",
        "steps"
       ],
       "additionalProperties": false
      },
      "_meta": {
       "anthropic/alwaysLoad": true
      }
     },
     {
      "name": "browser_fill",
      "description": "Fill 1 to 60 observed fields. Values are text, boolean, number or string array. A select, listbox or combobox takes the option text, even in a long or virtual list. For a multi-select, an array sets exactly those option texts; [] clears all. A drag-reorderable list takes all its row names in the wanted order. Optional submit is an observed ref. Returns each field status, submit outcome and diff.",
      "inputSchema": {
       "type": "object",
       "properties": {
        "tab": {
         "type": "string",
         "pattern": "^t[A-Za-z0-9_-]{1,64}$"
        },
        "fields": {
         "type": "array",
         "minItems": 1,
         "maxItems": 60,
         "items": {
          "type": "object",
          "properties": {
           "ref": {
            "type": "string",
            "pattern": "^(?:(?:f[0-9]+)?e[0-9]+|[sx][0-9]+)$"
           },
           "value": {
            "type": [
             "string",
             "boolean",
             "number",
             "array"
            ],
            "items": {
             "type": "string"
            },
            "maxItems": 100
           }
          },
          "required": [
           "ref",
           "value"
          ],
          "additionalProperties": false
         }
        },
        "submit": {
         "type": "string",
         "pattern": "^(?:(?:f[0-9]+)?e[0-9]+|[sx][0-9]+)$"
        },
        "sleight_stats": {
         "type": "object"
        }
       },
       "required": [
        "tab",
        "fields"
       ],
       "additionalProperties": false
      },
      "_meta": {
       "anthropic/alwaysLoad": true
      }
     },
     {
      "name": "browser_tabs",
      "description": "List, close, keep or hand off owned tabs. handoff wait:true waits for the user's Continue click, then reads fresh. Never request secrets. Never acquire engine-path tabs.",
      "inputSchema": {
       "type": "object",
       "properties": {
        "do": {
         "type": "string",
         "enum": [
          "list",
          "close",
          "keep",
          "handoff"
         ]
        },
        "tab": {
         "type": "string",
         "pattern": "^t[A-Za-z0-9_-]{1,64}$"
        },
        "wait": {
         "type": "boolean"
        }
       },
       "required": [
        "do"
       ],
       "additionalProperties": false
      },
      "_meta": {
       "anthropic/alwaysLoad": true
      }
     },
     {
      "name": "app_handoff",
      "description": "Pause the current native app for sign-in. Wait for the person to click Continue, then acquire and read the same app fresh, including its new window. Never request passwords or codes. Cancel keeps the app open.",
      "inputSchema": {
       "type": "object",
       "properties": {},
       "additionalProperties": false
      },
      "_meta": {
       "anthropic/alwaysLoad": true
      }
     }
    ]
   }
  },
  {
