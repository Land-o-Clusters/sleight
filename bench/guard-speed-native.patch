diff --git a/tests/guard-native.test.mjs b/tests/guard-native.test.mjs
new file mode 100644
index 0000000..0dc8d6a
--- /dev/null
+++ b/tests/guard-native.test.mjs
@@ -0,0 +1,71 @@
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import { constants, runInNewContext } from 'node:vm';
+import { createServer } from 'node:net';
+import { mkdtemp, rm } from 'node:fs/promises';
+import { tmpdir } from 'node:os';
+import { join } from 'node:path';
+import { guardedCode, readCode } from '../plugins/sleight/lib/document-scope.mjs';
+
+const expected = { title: 'a.txt', app: 'TextEdit', url: 'file:///tmp/a.txt' };
+const initial = { status: 'ok', epoch: 'one', pid: 12, processStart: 100, window: 3,
+  appId: 'com.apple.TextEdit', app: 'TextEdit', title: 'a.txt', document: 'file:///tmp/a.txt',
+  overlay: false, matchingWindows: 1 };
+async function fixture(t, action = () => {}, options = {}) {
+  const directory = await mkdtemp(join(tmpdir(), 'sleight-native-test-'));
+  const endpoint = { path: join(directory, 'n.sock'), token: 'test', appId: 'com.apple.TextEdit', timeoutMs: 1000 };
+  let native = { ...initial }, rows = '\t1 button Save, ID: Save';
+  const calls = [], output = [];
+  const server = createServer(socket => {
+    socket.on('error', () => {});
+    socket.once('data', () => { calls.push('native'); socket.end(JSON.stringify(native) + '\n'); });
+  });
+  await new Promise(resolve => server.listen(endpoint.path, resolve));
+  t.after(async () => { await new Promise(resolve => server.close(resolve)); await rm(directory, { recursive: true, force: true }); });
+  const raw = { getAXState: async () => { calls.push('tree'); return `Window: "a.txt", App: TextEdit.\n0 standard window, URL: file:///tmp/a.txt\n${rows}`; } };
+  for (const name of ['click', 'drag', 'scroll', 'typeText', 'pressKey', 'paste', 'setValue', 'selectText', 'performSecondaryAction']) {
+    raw[name] = async (...args) => { calls.push([name, ...args]); action({ setNative: patch => { native = { ...native, ...patch }; }, setRows: value => { rows = value; } }); };
+  }
+  const context = { cua: { getApp: async () => raw }, nodeRepl: { write: value => output.push(value) }, setTimeout, clearTimeout };
+  const run = code => runInNewContext(`(async () => {${code}})()`, context, { importModuleDynamically: constants.USE_MAIN_CONTEXT_DEFAULT_LOADER });
+  await run(readCode('globalThis.app = await cua.getApp("com.apple.TextEdit")'));
+  return { calls, output, run: code => run(guardedCode(code, expected, 'window changed', undefined, { nativeWindow: endpoint, ...options })) };
+}
+test('later keys, text, paste and coordinates use fresh native observations with one final tree', async t => {
+  const f = await fixture(t);
+  await f.run('await app.click(1); await app.pressKey("a"); await app.typeText("x"); await app.paste("x"); await app.click([1,2]); await app.scroll([1,2], "down"); await app.drag([1,2],[2,3]);');
+  assert.equal(f.calls.filter(x => x === 'tree').length, 2);
+  assert.equal(f.calls.filter(x => Array.isArray(x)).length, 7);
+  assert.ok(f.calls.filter(x => x === 'native').length >= 8);
+});
+test('new calls require a full tree and cannot reuse an earlier native baseline', async t => {
+  const f = await fixture(t);
+  await f.run('await app.pressKey("a"); await app.pressKey("b");');
+  f.calls.length = 0;
+  await f.run('await app.pressKey("c");');
+  assert.equal(f.calls.filter(x => x === 'tree').length, 2);
+});
+test('every changed or unavailable native identity stops the later action before input', async t => {
+  for (const patch of [{ window: 4 }, { processStart: 200 }, { pid: 13 }, { epoch: 'two' }, { title: 'b.txt' },
+    { document: 'file:///tmp/b.txt' }, { appId: 'other' }, { overlay: true }, { matchingWindows: 2 },
+    { status: 'expired' }, { status: 'unknown' }]) {
+    const f = await fixture(t, ({ setNative }) => setNative(patch));
+    await assert.rejects(f.run('await app.click(1); await app.pressKey("blocked");'), /Native window check stopped/);
+    assert.equal(f.calls.filter(x => Array.isArray(x)).length, 1);
+  }
+});
+test('element numbers, IDs, labels and lines still read the tree after native-checked input', async t => {
+  for (const selector of ['1', '{id:"Save"}', '{label:"Save"}', '{line:"button Save, ID: Save"}']) {
+    const f = await fixture(t);
+    await f.run(`await app.pressKey("a"); await app.pressKey("b"); await app.click(${selector});`);
+    assert.equal(f.calls.filter(x => x === 'tree').length, 3);
+  }
+  const f = await fixture(t, ({ setRows }) => setRows('\t1 button Delete\n\t2 button Save, ID: Save'));
+  await assert.rejects(f.run('await app.pressKey("a"); await app.pressKey("b"); await app.click(1);'), /changed what element 1 is/);
+  assert.equal(f.calls.filter(x => Array.isArray(x) && x[0] === 'click').length, 0);
+});
+test('strict document and change-review modes retain their full-read behavior', async t => {
+  const f = await fixture(t, () => {}, { fileOnly: true });
+  await f.run('await app.pressKey("a"); await app.typeText("b");');
+  assert.equal(f.calls.filter(x => x === 'tree').length, 3);
+});
