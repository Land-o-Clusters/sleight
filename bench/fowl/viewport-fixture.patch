+// Flush once when hidden or closed, before the debounced resize report can be lost.
+let finalSize = '';
+const finalReport = (reason) => {
+  const dimensions = innerWidth + 'x' + innerHeight;
+  if (dimensions === finalSize) return;
+  finalSize = dimensions;
+  clearTimeout(timer);
+  navigator.sendBeacon(base + '/api/log', JSON.stringify({ kind: 'size', field: reason,
+    width: innerWidth, height: innerHeight, path: location.pathname.slice(base.length) }));
+};
+addEventListener('pagehide', () => finalReport('pagehide'));
+document.addEventListener('visibilitychange', () => {
+  if (document.visibilityState === 'hidden') finalReport('visibilitychange');
+  else finalSize = '';
+});
